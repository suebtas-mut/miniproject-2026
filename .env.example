# =====================================================================
#  .env.example  (ระดับ ROOT — ใช้กับ docker-compose.yaml เท่านั้น)
#
#  วิธีใช้ :
#     1) คัดลอกไฟล์นี้เป็น .env  :   copy .env.example .env
#     2) แก้รหัสผ่านใน .env
#     3) docker compose up -d
#
#  ⚠️ ไฟล์ .env ถูก .gitignore ไว้แล้ว ห้าม commit เด็ดขาด (AR-03)
#  ⚠️ ค่า APP_USER / APP_USER_PASSWORD ต้องตรงกับ DB_USER / DB_PASS ใน backend/.env
#     ของทุกคนในทีม (รวมถึงสุขสรร) ต้องตรงกัน ไม่งั้นเชื่อมต่อไม่ได้
# =====================================================================

# ---------- รหัสผ่านของ SYS / SYSTEM (ผู้ดูแลฐานข้อมูล) ----------
# ⚠️ กฎของ Oracle 12.2+ : ยาวอย่างน้อย 8 ตัวอักษร
#    และต้องมี ตัวใหญ่ + ตัวเล็ก + ตัวเลข อย่างละอย่างน้อย 1 ตัว (ถ้าไม่ผ่าน container จะ error ตอน start)
# ⚠️ เปลี่ยนค่านี้เป็นรหัสผ่านของคุณเอง — ค่าตัวอย่างนี้ใช้ได้เฉพาะตอนทดลองบนเครื่องตัวเอง
ORACLE_PASSWORD=CHANGE_ME_StrongPassw0rd!

# ---------- User ของ Backend (Node.js + node-oracledb) ----------
# กฎเดียวกัน: 8+ ตัว, ตัวใหญ่ + ตัวเล็ก + ตัวเลข
APP_USER=SHUTTLE_APP
APP_USER_PASSWORD=CHANGE_ME_StrongPassw0rd!
