# =====================================================================
#  backend/.env.example  —  ตัวอย่างค่าตั้งค่า Backend (Node.js + Express + Oracle XE 21c)
#  ⚠️ ห้าม copy แล้วแก้ค่าจริงที่นี่แล้ว commit ขึ้น Git เด็ดขาด (AR-03)
#     วิธีใช้ :  cp .env.example .env   แล้วแก้ในไฟล์ .env เท่านั้น
#     ไฟล์ .env ถูก .gitignore ไว้แล้ว
# =====================================================================

# ---------- แอปพลิเคชัน ----------
NODE_ENV=development
PORT=3000
# ชื่อแอปที่แสดงใน log (ไม่ใช่ secret)
APP_NAME=shuttle-bus-backend
LOG_LEVEL=debug

# ---------- Oracle (Docker : gvenzl/oracle-xe:21-slim → Oracle 21c XE) ----------
# ⚠️ ค่า DB_USER / DB_PASS ต้องตรงกับค่า APP_USER / APP_USER_PASSWORD ใน .env ระดับ root
#     (ไม่ใช่ ORACLE_PASSWORD — ตัวนั้นคือรหัสของ SYS/SYSTEM ผู้ดูแล DB)
#     ของเครื่องทุกคน (รวมถึงเพื่อน) ต้องตรงกัน ไม่งั้นเชื่อมต่อไม่ได้
DB_USER=SHUTTLE_APP
DB_PASS=CHANGE_ME_MATCH_APP_USER_PASSWORD
DB_HOST=localhost
DB_PORT=1521
# ⚠️ ชื่อตัวแปรบอกว่า SERVICE NAME จริง ๆ เพราะ XEPDB1 ไม่ใช่ SID
#     (SID ของ XE คือ "XE" — ห้ามสับสน ดูคู่มือข้อ 6.1)
DB_SERVICE_NAME=XEPDB1
# เปิด/ปิด connection pool (ตาม 17.5.3 : poolMin 2, poolMax 10)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=60

# ---------- JWT (สำหรับ POST /auth/login) ----------
# ⚠️ JWT_SECRET ต้องสุ่มใหม่ทุกเครื่อง ห้ามใช้ค่านี้ในการ Deploy จริง
#     สร้างค่าใหม่ :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_EXPIRES_IN=1h
JWT_ISSUER=shuttle-bus-api

# ---------- QR Code ----------
# ความยาว qr_token ที่สุ่มใหม่ทุกครั้งที่จอง (เก็บใน booking.qr_token)
QR_TOKEN_BYTES=32
