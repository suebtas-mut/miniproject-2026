@startuml use-case-shuttle-bus
'=====================================================================
'  Use Case Diagram
'  ระบบรับส่งรถรับส่ง (Shuttle Bus) — สำนักงานเขตหนองจอก
'
'  Task     : T-004 (Sprint 0)  ·  ให้คะแนน : E0
'  Owner    : นายเก่งกาญ เชี่ยวชาญ  +  นางสาวสุขสรร มาณีศรี (ร่วมกัน)
'  AI Agent : @agent-architect
'  Spec     : docs/diagrams/use-case-spec.md
'  แหล่งที่มา : MINI PROJECT SHUTTLE BUS.pdf  +  docs/requirement-review-checklist.md
'
'  System Boundary : Flutter App (Android/Tablet)
'                    + Node.js/Express REST API
'                    + Oracle Database 21c XE
'  ⛔ นอกขอบเขต   : Web Application (React) — ยกเลิกแล้วตามข้อ 17.0
'=====================================================================

title
  <b>Use Case Diagram</b> — ระบบรับส่งรถรับส่ง (Shuttle Bus)
  <size:12>สำนักงานเขตหนองจอก · T-004 · Sprint 0</size>
end title

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7F9FC
  BorderColor #4A5568
  ArrowColor #4A5568
}
skinparam actor {
  BorderColor #2C5282
  BackgroundColor #EBF4FF
}
skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
hide empty methods

'---------------------------------------------------------------------
' ACTORS — บทบาทผู้ใช้งาน 4 บทบาท (ตรงกับ 17.1.1)
'---------------------------------------------------------------------
actor "ผู้ดูแลระบบ\n(Admin)" as Admin #CBD5E0
actor "พนักงานสำนักงาน\n(Staff)" as Staff #CBD5E0
actor "ผู้ใช้บริการ\n(Customer)" as Customer #CBD5E0
actor "คนขับรถ\n(Driver)" as Driver #CBD5E0

'---------------------------------------------------------------------
' SYSTEM BOUNDARY
'---------------------------------------------------------------------
rectangle "Shuttle Bus System" {

  '=== ระบบสิทธิ์และการเข้าสู่ระบบ (Auth) — M3 ==='
  package "ระบบสิทธิ์และการเข้าสู่ระบบ (Auth)\n<<M3 — 2 คะแนน>>" {
    usecase "UC-01\nเข้าสู่ระบบ" as UC01
    usecase "UC-02\nออกจากระบบ" as UC02
    usecase "UC-03\nเปลี่ยนรหัสผ่าน" as UC03
    usecase "UC-04\nโหลดสิทธิ์และ\nสร้างเมนูตามสิทธิ์" as UC04
    usecase "UC-05\nตรวจสิทธิ์การเข้าถึง" as UC05
  }

  '=== ระบบจัดการพนักงาน (Master 1) — M1 ==='
  package "ระบบจัดการพนักงาน (Master 1)\n<<M1 — 3 คะแนน>>" {
    usecase "UC-06\nจัดการข้อมูลพนักงาน\n(เพิ่ม/แก้ไข/ลบ)" as UC06
    usecase "UC-07\nจัดการข้อมูลแผนก" as UC07
    usecase "UC-08\nจัดการข้อมูลตำแหน่ง" as UC08
  }

  '=== ระบบกำหนดสิทธิ์ (Master 2) — M2 ==='
  package "ระบบกำหนดสิทธิ์การเข้าถึง (Master 2)\n<<M2 — 3 คะแนน · Dynamic>>" {
    usecase "UC-09\nจัดการ Role\n(เพิ่ม/แก้ไข/ลบ)" as UC09
    usecase "UC-10\nจัดการ Permission" as UC10
    usecase "UC-11\nจัดการ Permission Matrix\n(Role ↔ Permission)" as UC11
  }

  '=== ระบบจัดเส้นทางเดินรถ (Front 1) — F1 ==='
  package "ระบบจัดเส้นทางเดินรถ (Front 1)\n<<F1 — 2 คะแนน>>" {
    usecase "UC-12\nจัดการจุดจอด" as UC12
    usecase "UC-13\nจัดการเส้นทาง\n(จุดจอด + นาที + เวลารวม)" as UC13
  }

  '=== ระบบจัดรอบเวลา (Front 2) — F2 ==='
  package "ระบบจัดรอบเวลา รถ และคนขับ (Front 2)\n<<F2 — 3 คะแนน>>" {
    usecase "UC-14\nจัดการรอบเวลา\n(Schedule)" as UC14
    usecase "UC-15\nจัดการข้อมูลรถ\nและประเภทรถ" as UC15
    usecase "UC-16\nมอบหมายคนขับ\nพร้อมตรวจชนกัน" as UC16
    usecase "UC-17\nมอบหมายรถ\nพร้อมตรวจชนกัน" as UC17
  }

  '=== ระบบการจองรถ (Booking) — B1/B2/B3 ==='
  package "ระบบการจองรถของผู้ใช้บริการ (Booking)\n<<B1+B2+B3 — 9 คะแนน>>" {
    usecase "UC-18\nดูรายการรอบเวลา\nที่สามารถจองได้" as UC18
    usecase "UC-19\nจองรถ" as UC19
    usecase "UC-20\nดูรายการเดินทาง\nของฉัน" as UC20
    usecase "UC-21\nยกเลิกการจอง\nและคืนที่นั่ง" as UC21
    usecase "UC-22\nแสดง QR Code\nสำหรับ Check-in" as UC22
  }

  '=== ระบบสำหรับคนขับรถ (Driver) — D1..D4 ==='
  package "ระบบสำหรับคนขับรถ (Driver)\n<<D1–D4 — 6 คะแนน>>" {
    usecase "UC-23\nดูตารางงานรายวัน" as UC23
    usecase "UC-24\nเริ่มการเดินทาง" as UC24
    usecase "UC-25\nดูรายชื่อผู้โดยสาร\nรายจุดจอด (Manifest)" as UC25
    usecase "UC-26\nสแกน QR Code\nเพื่อขึ้นรถ" as UC26
    usecase "UC-27\nปิดงาน + สรุป\nและระบุ No Show" as UC27
  }

  '=== ระบบรายงาน (Report) — R1/R4/R6 ==='
  package "ระบบรายงาน (Report)\n<<ทีมเลือก R1 + R4 + R6 = 24 คะแนน>>" {
    usecase "UC-28\nรายงานที่ 1\nเปรียบเทียบคนขึ้น/ลง\nรายสัปดาห์" as UC28
    usecase "UC-29\nรายงานที่ 4\nสรุปยอดรายเส้นทางรายวัน" as UC29
    usecase "UC-30\nรายงานที่ 6\nสรุปการมอบหมายงานคนขับ" as UC30
  }
}

