<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY development network policy (T-013 integration fix).
     Allows cleartext HTTP solely to the Android host loopback addresses used by
     `flutter run` / local backend (http://10.0.2.2:3000). Everything else stays
     on the default deny. Release builds do NOT include this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
