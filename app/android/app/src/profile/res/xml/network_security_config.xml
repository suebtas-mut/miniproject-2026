<?xml version="1.0" encoding="utf-8"?>
<!-- PROFILE-ONLY development network policy (same as debug; `flutter run --profile`).
     Allows cleartext HTTP solely to the Android host loopback addresses used by the
     local backend (http://10.0.2.2:3000). Release builds do NOT include this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
